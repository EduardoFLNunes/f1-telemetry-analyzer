+  drawDebugMarker(ctx, nearestCenterlinePoint, scale, '#facc15', 'nearest phys');
+
+  const car = toRenderPoint(frame.mapPosition);
+  const projected = toRenderPoint(frame.projectedPosition);
+  const nearest = toRenderPoint(nearestCenterlinePoint);
+  ctx.save();
+  ctx.lineWidth = 1.2 / scale;
