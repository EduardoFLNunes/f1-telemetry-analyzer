# Python
__pycache__/
*.pyc

# Virtual environments
venv/
.venv/
backend/venv/
backend/.venv/

# Node
node_modules/

# Build
dist/
build/
backend/dist/
backend/build/
desktop/dist/
desktop/out/
desktop/release/
frontend/dist/
*.spec

# Logs
*.log
logs/

# Runtime recordings and generated caches (regenerated on demand, not source)
data/recordings/
data/assisted_analysis/
data/external_references/
data/fastf1_cache/
data/cache/
data/feature_store/
data/telemetry_db/
backend/data/fastf1_cache/
backend/data/feature_store/
backend/data/telemetry_db/

# Old pre-Assetto-Corsa snapshot, superseded and unreferenced by current code
backup/

# Geometry-authoring scratch artifacts (candidate/validation/audit dumps from
# scripts/build_interlagos_*). The app loads a single consolidated geometry at
# runtime; the cascade inputs below stay tracked only so it can be regenerated
# via resolve_fixed_geometry_from_cascade().
data/debug/*
!data/debug/interlagos_consolidated_geometry.json
!data/debug/interlagos_track_only_fixed_geometry.json
!data/debug/interlagos_reta_oposta_final_local_fix_candidate.json
!data/debug/interlagos_reta_oposta_final_local_fix_validation.json
!data/debug/interlagos_pit_access_asphalt_merge_fix_candidate.json
!data/debug/interlagos_pit_access_asphalt_merge_fix_validation.json
!data/debug/interlagos_pit_access_from_pit_lane_ai.json
!data/debug/track_edges_interval_raycast_vhe_interlagos.json

# Bundle de branches nao mescladas: backup de objetos git, 114 MB
archives/

# Artefatos do subsistema de aprendizado de tracado (regenerados por script)
data/ml/

# Modelo de referencia do piloto: reconstruido a partir de data/recordings/ toda
# vez que ele grava voltas, e portanto dado de execucao, nao fonte. O tracado
# otimo ao lado dele e o oposto -- sai da busca offline e e o artefato que o
# instalador precisa levar junto.
data/reference_models/*.json
!data/reference_models/*.optimal.json
