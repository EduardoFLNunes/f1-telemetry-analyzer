+      NOMES.forEach((nome) => {
+        const destino = this.linhas![nome];
+        r.pontos![nome].forEach((valor, j) => {
+          destino[indices[j]] = valor;
+        });
+      });
+    } else {
+      return false; // pontos de outra volta sem a volta inteira: espera a próxima leitura
