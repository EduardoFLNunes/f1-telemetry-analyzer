+                "minimaSuaKmh": 80.0, "minimaRefKmh": 110.0, "aceleradorM": acelerador, "tracadoM": tracado,
+                "sDaCurva": 3100.0}
+    return [curva("C12", perdas[0]), curva("C04", perdas[1]), curva("C01", perdas[2])]
