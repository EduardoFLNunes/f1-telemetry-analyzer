+    void _l; void _p; void _c;
+    const mudou = this.seq !== seq || this.versao !== versao;
+    this.versao = versao;
+    this.seq = seq;
+    this.carro = carro ?? null;
+    this.cabecalho = cabecalho;
+    return mudou;
+  }
