index 00000000..d7c063ad
--- /dev/null
+++ b/backend/core/coleta/anotacao.py
@@ -0,0 +1,107 @@
+"""A anotacao "Todas as voltas foram minhas" (pedido 32, Parte B.1 e B.2).
+
+Cada gravacao fora do relatorio tem uma origem, pela conferencia da Coleta:
+
+* **indicador de IA gravado** (app 0.3.0 em diante): todas as voltas `humano`
+  pelo indicador. Nao precisa de anotacao.
+* **sem indicador:** voltas `desconhecida`. Precisa da confirmacao do piloto de
+  que todas as voltas foram dele; so estas tem o botao.
+* **com voltas da IA ou misturada:** fica como esta, sem botao.
+
+Ao confirmar, a linha entra em `docs/experimentos/anotacoes_de_sessao.csv` do
+repositorio configurado, no formato do arquivo, com fim de linha CRLF e a
+observacao "anotada pelo app em AAAA-MM-DD". O commit fica para depois: a
+anotacao so vale para o coach na proxima rodada do `atualizar_coach`.
+"""
+from __future__ import annotations
+
+import csv
+import io
+import re
+import threading
+from datetime import date
+from pathlib import Path
+from typing import Any, Dict, List, Mapping, Optional
+
+ARQUIVO = Path("docs") / "experimentos" / "anotacoes_de_sessao.csv"
+COLUNAS = ["sessao", "origem", "carModel", "anotado_em", "observacao"]
+CARRO_PADRAO = "rss_formula_rss_3_v6_2026"
+_SESSAO_VALIDA = re.compile(r"^\d{4}-\d{2}-\d{2}_\d{2}-\d{2}-\d{2}_[A-Za-z0-9_]+$")
+_lock = threading.Lock()
+
+INDICADOR = "indicador"
+SEM_INDICADOR = "sem_indicador"
+COM_IA = "com_ia"
+SEM_CONFERENCIA = "sem_conferencia"
+
+
+def classificar(conferencia: Optional[Mapping[str, Any]]) -> str:
+    """A origem da gravacao pela conferencia: indicador, sem indicador ou com voltas da IA."""
+    voltas = list((conferencia or {}).get("voltas") or [])
+    if not voltas:
+        return SEM_CONFERENCIA
+    origens = {str(v.get("origem") or "desconhecida") for v in voltas}
+    if origens & {"ia", "misturada"}:
+        return COM_IA
+    if origens == {"humano"}:
+        return INDICADOR
+    return SEM_INDICADOR
+
+
+def ler_anotacoes(repositorio: Path) -> List[Dict[str, str]]:
+    caminho = Path(repositorio) / ARQUIVO
+    if not caminho.exists():
+        return []
+    with caminho.open(encoding="utf-8", newline="") as handle:
+        return [dict(linha) for linha in csv.DictReader(handle)]
+
+
+def linha_da_anotacao(sessao: str, carro: str, hoje: date) -> str:
+    """A linha no formato do arquivo (observacao entre aspas, como as outras), com CRLF."""
+    dia = hoje.isoformat()
+    buffer = io.StringIO()
+    escritor = csv.writer(buffer, lineterminator="\r\n", quoting=csv.QUOTE_MINIMAL)
+    escritor.writerow([sessao, "humano", carro, dia, f"anotada pelo app em {dia}"])
+    texto = buffer.getvalue()
+    # As outras linhas poem a observacao entre aspas mesmo sem virgula: mesma forma aqui.
+    if not texto.rstrip("\r\n").endswith('"'):
+        corpo, _ = texto.rsplit(",", 1)
+        texto = f'{corpo},"anotada pelo app em {dia}"\r\n'
+    return texto
+
+
+class AnotacaoRecusada(ValueError):
+    pass
+
+
+def anotar(repositorio: Path, sessao: str, conferencia: Optional[Mapping[str, Any]],
+           hoje: Optional[date] = None) -> Dict[str, Any]:
+    """Acrescenta a anotacao de uma gravacao sem indicador; devolve a linha gravada."""
+    if not _SESSAO_VALIDA.match(sessao or ""):
+        raise AnotacaoRecusada(f"nome de sessão inválido: {sessao!r}")
+    if (conferencia or {}).get("sessao") not in (None, sessao):
+        raise AnotacaoRecusada("a conferência não é desta sessão")
+    tipo = classificar(conferencia)
+    if tipo == SEM_CONFERENCIA:
+        raise AnotacaoRecusada("confira a sessão na aba Coleta de dados antes de anotar")
+    if tipo == INDICADOR:
+        raise AnotacaoRecusada("esta gravação tem o indicador de IA: não precisa de anotação")
+    if tipo == COM_IA:
+        raise AnotacaoRecusada("esta gravação tem voltas da IA ou misturadas: não pode ser anotada como sua")
+    gravado = ((conferencia or {}).get("gravacao") or {}).get("carModel")
+    carro = str(gravado or CARRO_PADRAO)
+    caminho = Path(repositorio) / ARQUIVO
+    with _lock:
+        if any(a.get("sessao") == sessao for a in ler_anotacoes(repositorio)):
+            raise AnotacaoRecusada("esta gravação já está anotada")
+        linha = linha_da_anotacao(sessao, carro, hoje or date.today())
+        if caminho.exists():
+            atual = caminho.read_bytes()
+            prefixo = b"" if not atual or atual.endswith(b"\n") else b"\r\n"
+        else:
+            caminho.parent.mkdir(parents=True, exist_ok=True)
+            prefixo = (",".join(COLUNAS) + "\r\n").encode("utf-8")
+        with caminho.open("ab") as handle:
+            handle.write(prefixo + linha.encode("utf-8"))
+    return {"sessao": sessao, "linha": linha.rstrip("\r\n"), "arquivo": str(caminho),
+            "carro": carro, "carroGravado": bool(gravado), "commit": False}
diff --git a/backend/core/coleta/rodada_coach.py b/backend/core/coleta/rodada_coach.py
new file mode 100644
index 00000000..4b6be3e6
--- /dev/null
+++ b/backend/core/coleta/rodada_coach.py
@@ -0,0 +1,247 @@
+"""O botao "Atualizar coach e relatorio" (pedido 32, Parte B.3).
+
+Roda o mesmo `tools/atualizar_coach.py`, incremental, com o Python e a pasta do
+repositorio configurado na Coleta: o backend empacotado nao tem tudo o que o
+comando usa, e o codigo continua num caminho so. O botao nao muda o comando,
+os criterios nem as travas.
+
+* **Ligado** quando o repositorio esta configurado (com o Python dele), nada
+  esta sendo gravado e nenhuma rodada esta em andamento: nem pelo app, nem
+  pelo terminal (a trava de execucao, `core.coleta.trava_coach`).
+* **Durante:** os 7 passos, um a um, lidos da saida do comando, e o log
+  inteiro num arquivo em `<pasta de dados>/data/coach_rodadas/`.
+* **No fim:** as sessoes lidas, as voltas de cada uma no store v2, as
+  referencias antes e depois e a contagem oficial da M1. Depois de uma rodada
+  completa, o coach ao vivo recarrega o modelo.
+* **Parada numa trava** (`PARADO: ...`): a mensagem do comando, como ele a
+  escreveu; o servico nao tenta de novo sozinho.
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+import subprocess
+import sys
+import threading
+from datetime import datetime
+from pathlib import Path
+from typing import Any, Callable, Dict, List, Optional, Sequence
+
+from .oficial import contagem_oficial
+from .trava_coach import ler_trava, mensagem_de_ocupada
+
+PASSOS = (
+    ("1", "Inventário novo"),
+    ("2", "Anotações de 04/10 e de sessão inteira"),
+    ("3", "Sessões novas sem anotação"),
+    ("4", "Backup e treino do modelo do coach"),
+    ("5", "Resumo do coach"),
+    ("6", "Store v2, com as checagens"),
+    ("7", "Relatório de evolução"),
+)
+_PASSO = re.compile(r"^(\d)/7 ")
+_TAMBEM = re.compile(r" (\d)/7 ")
+_SESSAO_LIDA = re.compile(r"^\[(\d+)/(\d+)\] (\S+): (\d+) voltas(?P<cache> \(cache\))?\s*$")
+LINHAS_GUARDADAS = 400
+
+
+def comando_padrao(repositorio: Path) -> Optional[List[str]]:
+    """O Python do repositorio e o comando; None quando o Python dele nao existe."""
+    python = Path(repositorio) / ".venv" / ("Scripts/python.exe" if os.name == "nt" else "bin/python")
+    script = Path(repositorio) / "backend" / "tools" / "atualizar_coach.py"
+    if not python.exists() or not script.exists():
+        return None
+    return [str(python), str(script)]
+
+
+def _referencias(repositorio: Path) -> Dict[str, Any]:
+    try:
+        dados = json.loads((Path(repositorio) / "data" / "ml" / "origem" / "atualizar_coach.json").read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError):
+        return {}
+    return dados.get("referencias") or {}
+
+
+def _voltas_no_store(repositorio: Path, sessoes: Sequence[str]) -> Dict[str, int]:
+    try:
+        meta = json.loads((Path(repositorio) / "data" / "ml" / "laps_grid_v2_meta.json").read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError):
+        return {}
+    contagem: Dict[str, int] = {s: 0 for s in sessoes}
+    for volta in meta.get("laps") or []:
+        sid = volta.get("session_id")
+        if sid in contagem:
+            contagem[sid] += 1
+    return contagem
+
+
+class RodadaDoCoach:
+    def __init__(
+        self,
+        repositorio: Callable[[], Optional[Path]],
+        gravando: Callable[[], bool],
+        pasta_de_logs: Path,
+        recarregar_coach: Callable[[], None],
+        comando: Callable[[Path], Optional[List[str]]] = comando_padrao,
+    ):
+        self._repositorio = repositorio
+        self._gravando = gravando
+        self.pasta_de_logs = Path(pasta_de_logs)
+        self._recarregar = recarregar_coach
+        self._comando = comando
+        self._lock = threading.Lock()
+        self._processo: Optional[subprocess.Popen] = None
+        self._thread: Optional[threading.Thread] = None
+        self._rodada: Optional[Dict[str, Any]] = None
+
+    # ------------------------------------------------------------ estado ---
+
+    def motivos_para_desligar(self) -> List[str]:
+        motivos = []
+        repo = self._repositorio()
+        if repo is None:
+            motivos.append("o repositório não está configurado (aba Coleta de dados)")
+        elif self._comando(repo) is None:
+            motivos.append(f"o repositório configurado não tem o Python dele (.venv) ou o tools/atualizar_coach.py: {repo}")
+        if self._gravando():
+            motivos.append("uma sessão está sendo gravada; espere ela terminar")
+        if self.em_andamento():
+            motivos.append("uma rodada do app está em andamento")
+        elif repo is not None:
+            trava = ler_trava(repo)
+            if trava and trava.get("ativa"):
+                motivos.append(mensagem_de_ocupada(trava).replace("PARADO: ", ""))
+        return motivos
+
+    def em_andamento(self) -> bool:
+        with self._lock:
+            return self._thread is not None and self._thread.is_alive()
+
+    def estado(self) -> Dict[str, Any]:
+        motivos = self.motivos_para_desligar()
+        with self._lock:
+            rodada = json.loads(json.dumps(self._rodada)) if self._rodada else None
+        return {"ligado": not motivos, "motivos": motivos, "emAndamento": self.em_andamento(), "rodada": rodada,
+                "passos": [{"id": p, "nome": n} for p, n in PASSOS]}
+
+    # ------------------------------------------------------------ rodada ---
+
+    def iniciar(self) -> Dict[str, Any]:
+        motivos = self.motivos_para_desligar()
+        if motivos:
+            raise RuntimeError("; ".join(motivos))
+        repo = self._repositorio()
+        assert repo is not None
+        comando = self._comando(repo)
+        assert comando is not None
+        inicio = datetime.now()
+        self.pasta_de_logs.mkdir(parents=True, exist_ok=True)
+        log = self.pasta_de_logs / f"atualizar_coach_{inicio.strftime('%Y-%m-%d_%H-%M-%S')}.log"
+        with self._lock:
+            self._rodada = {
+                "situacao": "rodando",
+                "inicio": inicio.isoformat(timespec="seconds"),
+                "fim": None,
+                "repositorio": str(repo),
+                "comando": comando,
+                "log": str(log),
+                "passos": {p: "pendente" for p, _ in PASSOS},
+                "passoAtual": None,
+                "linhas": [],
+                "sessoesLidas": [],
+                "mensagemDeParada": None,
+                "codigo": None,
+                "resumo": None,
+                "referenciasAntes": _referencias(repo),
+                "coachRecarregado": False,
+            }
+            self._thread = threading.Thread(target=self._rodar, args=(repo, comando, log), daemon=True,
+                                            name="atualizar-coach")
+            self._thread.start()
+        return self.estado()
+
+    def _rodar(self, repo: Path, comando: List[str], log: Path) -> None:
+        env = {**os.environ, "PYTHONIOENCODING": "utf-8", "PYTHONUNBUFFERED": "1", "AT_COACH_RODADA_ORIGEM": "app"}
+        flags = 0x08000000 if sys.platform == "win32" else 0  # CREATE_NO_WINDOW
+        codigo: Optional[int] = None
+        try:
+            with log.open("w", encoding="utf-8", newline="\n") as saida:
+                processo = subprocess.Popen(
+                    comando, cwd=str(Path(repo) / "backend"), stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+                    text=True, encoding="utf-8", errors="replace", env=env, creationflags=flags,
+                )
+                with self._lock:
+                    self._processo = processo
+                assert processo.stdout is not None
+                for linha in processo.stdout:
+                    saida.write(linha)
+                    saida.flush()
+                    self._linha(linha.rstrip("\r\n"))
+                codigo = processo.wait()
+        except OSError as erro:
+            self._linha(f"PARADO: o comando nao abriu: {erro}")
+            codigo = -1
+        self._fechar(repo, codigo)
+
+    def _linha(self, linha: str) -> None:
+        with self._lock:
+            r = self._rodada
+            if r is None:
+                return
+            r["linhas"].append(linha)
+            del r["linhas"][:-LINHAS_GUARDADAS]
+            passo = _PASSO.match(linha)
+            if passo:
+                ids = [passo.group(1)] + _TAMBEM.findall(linha)
+                for p, estado in r["passos"].items():
+                    if estado == "rodando":
+                        r["passos"][p] = "feito"
+                for p in ids:
+                    if p in r["passos"]:
+                        r["passos"][p] = "rodando"
+                r["passoAtual"] = ids[-1]
+            lida = _SESSAO_LIDA.match(linha)
+            if lida and not lida.group("cache") and r.get("passoAtual") == "1":
+                r["sessoesLidas"].append({"sessao": lida.group(3), "voltas": int(lida.group(4))})
+            if linha.startswith("PARADO:") and not r["mensagemDeParada"]:
+                r["mensagemDeParada"] = linha
+
+    def _fechar(self, repo: Path, codigo: Optional[int]) -> None:
+        with self._lock:
+            r = self._rodada
+            assert r is not None
+            r["codigo"] = codigo
+            r["fim"] = datetime.now().isoformat(timespec="seconds")
+            parada = r["mensagemDeParada"]
+            if codigo == 0 and not parada:
+                r["situacao"] = "concluida"
+                for p in r["passos"]:
+                    r["passos"][p] = "feito"
+            else:
+                r["situacao"] = "parada" if parada else "falhou"
+                for p, estado in r["passos"].items():
+                    if estado == "rodando":
+                        r["passos"][p] = "parado"
+            sessoes = [s["sessao"] for s in r["sessoesLidas"]]
+            antes = r["referenciasAntes"]
+        resumo = None
+        if codigo == 0 and not parada:
+            store = _voltas_no_store(repo, sessoes)
+            resumo = {
+                "sessoesLidas": [{"sessao": s, "voltasNoStore": store.get(s, 0)} for s in sessoes],
+                "referenciasAntes": antes,
+                "referenciasDepois": _referencias(repo),
+                "m1": contagem_oficial(repo),
+            }
+        recarregado = False
+        if codigo == 0 and not parada:
+            try:
+                self._recarregar()
+                recarregado = True
+            except Exception as erro:  # o modelo novo ja esta no disco; o coach o le na proxima abertura
+                self._linha(f"aviso: o coach ao vivo nao recarregou o modelo: {erro}")
+        with self._lock:
+            self._rodada["resumo"] = resumo
+            self._rodada["coachRecarregado"] = recarregado
+            self._processo = None
diff --git a/backend/core/coleta/trava_coach.py b/backend/core/coleta/trava_coach.py
new file mode 100644
index 00000000..bcdef3ab
--- /dev/null
+++ b/backend/core/coleta/trava_coach.py
@@ -0,0 +1,127 @@
+"""A trava de execucao do `atualizar_coach` (pedido 32, Parte B).
+
+Uma rodada por vez, venha ela do terminal ou do botao do app: o comando cria
+`data/ml/atualizar_coach.lock` no repositorio antes do passo 1 e apaga no fim,
+mesmo quando para numa trava. O arquivo diz quem roda (processo e inicio).
+
+Uma trava cujo processo ja nao existe (o comando foi morto, o PC desligou) e
+velha: a proxima rodada a substitui e diz isso. A trava nao muda nada do que o
+comando le ou grava; ela so impede duas rodadas ao mesmo tempo.
+"""
+from __future__ import annotations
+
+import ctypes
+import json
+import os
+import sys
+from datetime import datetime
+from pathlib import Path
+from typing import Any, Dict, Optional
+
+NOME_DA_TRAVA = "atualizar_coach.lock"
+
+
+def caminho_da_trava(repositorio: Path) -> Path:
+    return Path(repositorio) / "data" / "ml" / NOME_DA_TRAVA
+
+
+def processo_vivo(pid: int) -> bool:
+    """O processo existe? Sem `os.kill(pid, 0)`, que no Windows encerraria o processo."""
+    if pid <= 0:
+        return False
+    if sys.platform == "win32":
+        kernel = ctypes.windll.kernel32
+        handle = kernel.OpenProcess(0x1000, False, int(pid))  # PROCESS_QUERY_LIMITED_INFORMATION
+        if not handle:
+            return False
+        try:
+            codigo = ctypes.c_ulong()
+            if not kernel.GetExitCodeProcess(handle, ctypes.byref(codigo)):
+                return False
+            return codigo.value == 259  # STILL_ACTIVE
+        finally:
+            kernel.CloseHandle(handle)
+    try:
+        os.kill(pid, 0)
+    except ProcessLookupError:
+        return False
+    except PermissionError:
+        return True
+    return True
+
+
+def ler_trava(repositorio: Path) -> Optional[Dict[str, Any]]:
+    """O conteudo da trava, com `ativa` (o processo ainda roda); None sem trava."""
+    caminho = caminho_da_trava(repositorio)
+    try:
+        dados = json.loads(caminho.read_text(encoding="utf-8"))
+    except FileNotFoundError:
+        return None
+    except (OSError, json.JSONDecodeError):
+        # Acabou de ser criada e ainda esta sendo escrita: conta como ativa por alguns segundos.
+        try:
+            recente = (datetime.now().timestamp() - caminho.stat().st_mtime) < 10
+        except OSError:
+            recente = False
+        return {"pid": 0, "ativa": recente, "arquivo": str(caminho)}
+    pid = int(dados.get("pid") or 0)
+    return {**dados, "pid": pid, "ativa": processo_vivo(pid), "arquivo": str(caminho)}
+
+
+class TravaOcupada(RuntimeError):
+    def __init__(self, info: Dict[str, Any]):
+        self.info = info
+        super().__init__(mensagem_de_ocupada(info))
+
+
+def mensagem_de_ocupada(info: Dict[str, Any]) -> str:
+    inicio = str(info.get("inicio") or "")[11:19] or "horario desconhecido"
+    origem = info.get("origem") or "terminal"
+    return (f"PARADO: outra rodada do atualizar_coach esta em andamento "
+            f"(processo {info.get('pid')}, desde {inicio}, pelo {origem}).")
+
+
+class TravaDeExecucao:
+    """`with TravaDeExecucao(repo):` segura a trava durante a rodada."""
+
+    def __init__(self, repositorio: Path, origem: Optional[str] = None):
+        self.caminho = caminho_da_trava(repositorio)
+        self.repositorio = Path(repositorio)
+        self.origem = origem or os.environ.get("AT_COACH_RODADA_ORIGEM") or "terminal"
+        self.substituiu: Optional[Dict[str, Any]] = None
+        self._minha = False
+
+    def __enter__(self) -> "TravaDeExecucao":
+        self.caminho.parent.mkdir(parents=True, exist_ok=True)
+        conteudo = json.dumps({"pid": os.getpid(), "inicio": datetime.now().isoformat(timespec="seconds"),
+                               "origem": self.origem}, ensure_ascii=False)
+        for _ in range(2):
+            try:
+                fd = os.open(str(self.caminho), os.O_CREAT | os.O_EXCL | os.O_WRONLY)
+            except FileExistsError:
+                info = ler_trava(self.repositorio) or {}
+                if info.get("ativa"):
+                    raise TravaOcupada(info)
+                # Velha: o processo dela nao existe mais.
+                self.substituiu = info
+                try:
+                    self.caminho.unlink()
+                except FileNotFoundError:
+                    pass
+                continue
+            with os.fdopen(fd, "w", encoding="utf-8") as handle:
+                handle.write(conteudo)
+            self._minha = True
+            return self
+        raise TravaOcupada(ler_trava(self.repositorio) or {})
+
+    def __exit__(self, *exc) -> None:
+        if not self._minha:
+            return
+        try:
+            info = json.loads(self.caminho.read_text(encoding="utf-8"))
+            if int(info.get("pid") or 0) == os.getpid():
+                self.caminho.unlink()
+        except (OSError, json.JSONDecodeError, ValueError):
+            pass
+        self._minha = False
