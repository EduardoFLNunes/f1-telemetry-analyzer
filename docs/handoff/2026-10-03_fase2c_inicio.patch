+        line = "ANOTE o numero no jogo desta volta (primeira do bloco 1): ____"
+        self.assertEqual(text.count(line), 1)
+        self.assertLess(text.index("BLOCO 1"), text.index(line))
+        self.assertLess(text.index(line), text.index("BLOCO 2"))
