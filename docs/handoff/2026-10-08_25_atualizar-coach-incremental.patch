+def assert_same_tables(case, left: Path, right: Path):
+    for name in TABLES:
+        a, b = pd.read_parquet(left / name), pd.read_parquet(right / name)
+        pd.testing.assert_frame_equal(a, b, check_exact=True, obj=name)
