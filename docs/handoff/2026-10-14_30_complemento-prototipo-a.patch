+    top: 12px;
+    bottom: auto;
+    left: 12px;
+    right: auto;
+    width: 110px;
+    height: 84px;
+  }
+  .fantasma-hud {
+    position: static;
+    padding: 12px 14px 14px;
+    background: none;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 10px 16px;
+  }
+  .hud-centro {
+    grid-column: 1 / -1;
+    order: -1;
+  }
+  .hud-velocidade {
+    font-size: 34px;
+  }
+}
+/* Dois painéis lado a lado, que viram um embaixo do outro na tela estreita (protótipo: grid2). */
+.grade-dupla {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(520px, 100%), 1fr));
+  gap: 16px;
+}
+/* Sessões: uma sessão do relatório por linha (protótipo: sescard). */
+.lista-sessoes {
+  display: flex;
+  flex-direction: column;
+}
+.cartao-sessao {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  align-items: center;
+  gap: 8px 18px;
+  padding: 14px 0;
+  border-bottom: 1px solid var(--linha-fraca);
+}
+.cartao-sessao:last-child {
+  border-bottom: 0;
+}
+.titulo-cartao {
+  margin: 0;
+  font-family: var(--fonte-titulo);
+  font-weight: 700;
+  font-size: 20px;
+  letter-spacing: 0.02em;
+}
+.fatos {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px 18px;
+  font-size: 13px;
+}
+@media (max-width: 640px) {
+  .cartao-sessao {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
+/* Rádio nesta volta: as frases do coach, embaixo do replay. */
+.radio-da-volta {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+.radio-lista {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(min(360px, 100%), 1fr));
+  gap: 6px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+.radio-frase {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  width: 100%;
+  padding: 8px 12px;
+  border: 1px solid var(--linha-fraca);
+  border-radius: var(--raio-1);
+  background: var(--superficie);
+  color: var(--texto-1);
+  font: 13px var(--fonte-texto);
+  text-align: left;
+  cursor: pointer;
+}
+.radio-frase:hover {
+  background: var(--realce-1);
+}
+.radio-frase[aria-current='true'] {
+  border-color: var(--vermelho);
+  box-shadow: inset 3px 0 0 var(--vermelho);
+}
+/* Tabela densa (as 14 curvas da tela Volta), como no protótipo A: o texto quebra em vez de alargar o painel. */
+.tabela--compacta th,
+.tabela--compacta td {
+  padding: 7px 8px;
+}
+.tabela--compacta thead th {
+  white-space: normal;
+}
+/* Tabelas por curva (Volta e Evolução): o nome da curva é o dado da linha, como no protótipo A, e não um rótulo apagado. */
+.tabela--curvas tbody th {
+  color: var(--texto-1);
+  font-size: 13.5px;
+  border-bottom: 1px solid var(--linha-fraca);
+}
+.tabela--curvas tbody tr:last-child th {
+  border-bottom: 0;
+}
+.tabela--curvas tfoot th,
+.tabela--curvas tfoot td {
+  border-top: 1px solid var(--linha);
+  border-bottom: 0;
+}
