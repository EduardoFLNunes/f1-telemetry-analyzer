+++ b/backend/tests/test_leitura.py
@@ -0,0 +1,125 @@
+"""Rotas de leitura das telas Sessoes, Volta e Evolucao (pedido 30).
+
+So leem o que o `atualizar_coach` ja gravou. Os testes montam um repositorio
+de mentira com os mesmos arquivos e conferem que o que sai e o que esta no
+arquivo, sem conta nova; o ultimo confere a volta da conferencia do pedido 30
+nos arquivos reais, quando eles existem.
+"""
+
+import json
+from pathlib import Path
+
+import pandas as pd
+import pytest
+
+from core.leitura import arquivos
+
+REPO = Path(__file__).resolve().parents[2]
+
+
+def _escrever(caminho: Path, dados) -> None:
+    caminho.parent.mkdir(parents=True, exist_ok=True)
+    caminho.write_text(json.dumps(dados), encoding="utf-8")
+
+
+def _repositorio(tmp_path: Path) -> Path:
+    raiz = tmp_path / "repo"
+    evolucao = raiz / "data" / "ml" / "evolucao"
+    _escrever(evolucao / "resumo.json", {"formato": "evolucao-resumo/1", "sessoes": [{"sessao": "2026-10-05-2"}]})
+    _escrever(evolucao / "sessao_2026-10-05-2.json", {"formato": "evolucao-sessao/1", "sessao": "2026-10-05-2",
+                                                       "voltas": [{"volta": "g#0008", "tempo_s": 90.629}]})
+    _escrever(raiz / "data" / "reference_models" / "vhe_interlagos.json", {
+        "geometry_id": "abc", "built_at": "2026-10-10T20:38:13", "lap_count": 43,
+        "references": {"volta_ia": {"lap_id": "ia#0013", "lap_seconds": 84.828, "carro": "c"},
+                       "minha_melhor": {"lap_id": "eu#0018", "lap_seconds": 89.389, "carro": "c"}},
+    })
+    # Store v2: duas voltas, fora de ordem na grade, como o parquet pode guardar.
+    linhas = []
+    for lap_id, desloc in (("g#0008", 0.0), ("ia#0013", 0.5)):
+        for i in (3, 0, 2, 1):
+            linhas.append({"lap_id": lap_id, "grid_index": i, "elapsed_s": i * 10.0 + desloc, "speed_kmh": 100.0 + i,
+                           "throttle": 0.5, "brake": 0.0, "lateral": 0.1 * i, "outra": 1.0})
+    ml = raiz / "data" / "ml"
+    ml.mkdir(parents=True, exist_ok=True)
+    pd.DataFrame(linhas).to_parquet(ml / "laps_grid_v2.parquet", index=False)
+    _escrever(ml / "laps_grid_v2_meta.json", {
+        "geometry_id": "abc", "grid_size": 4, "track_length": 40.0, "aprovado": True,
+        "laps": [{"lap_id": "g#0008", "session_id": "g", "sequence": 8, "game_lap_number": 9, "lap_time_s": 40.2,
+                  "replay_lap_id": "rec__g__9", "origem": "humano", "carModel": "c"},
+                 {"lap_id": "ia#0013", "session_id": "ia", "sequence": 13, "lap_time_s": 40.7, "origem": "ia"}],
+    })
+    _escrever(raiz / "data" / "reference_models" / "vhe_interlagos.geometry.json", {
+        "version": 1, "geometry_id": "abc", "track_length": 40.0, "step": 10.0, "normal_side": "left",
+        "x": [0.0, 10.0, 10.0, 0.0], "z": [0.0, 0.0, 10.0, 10.0], "s": [0.0, 10.0, 20.0, 30.0],
+        "normal_x": [0.0, -1.0, 0.0, 1.0], "normal_z": [1.0, 0.0, -1.0, 0.0], "microsector_edges": [0.0, 20.0, 40.0],
+    })
+    return raiz
+
+
+def test_evolucao_devolve_os_arquivos_como_estao(tmp_path):
+    raiz = _repositorio(tmp_path)
+    resumo = arquivos.ler_resumo(raiz)
+    assert resumo["disponivel"] and resumo["resumo"]["formato"] == "evolucao-resumo/1"
+    assert resumo["arquivosDeSessao"] == ["2026-10-05-2"]
+    sessao = arquivos.ler_sessao(raiz, "2026-10-05-2")
+    assert sessao["disponivel"] and sessao["sessao"]["voltas"][0]["tempo_s"] == 90.629
+
+
+def test_sem_arquivo_ou_nome_invalido_diz_por_que(tmp_path):
+    raiz = _repositorio(tmp_path)
+    assert arquivos.ler_resumo(None)["disponivel"] is False
+    assert arquivos.ler_resumo(tmp_path / "vazio")["disponivel"] is False
+    assert arquivos.ler_sessao(raiz, "2026-10-09")["disponivel"] is False
+    # Nada fora da pasta da evolucao: o nome da sessao e conferido antes de abrir.
+    assert "inválido" in arquivos.ler_sessao(raiz, "../../segredo")["motivo"]
+
+
+def test_referencias_do_modelo_do_coach(tmp_path):
+    ref = arquivos.ler_referencias(_repositorio(tmp_path))
+    assert ref["disponivel"] and ref["geometryId"] == "abc"
+    assert ref["referencias"]["volta_ia"] == {"volta": "ia#0013", "tempoS": 84.828, "carro": "c"}
+    assert ref["referencias"]["minha_melhor"]["volta"] == "eu#0018"
+
+
+def test_volta_do_store_na_ordem_da_grade_e_sem_conta(tmp_path):
+    raiz = _repositorio(tmp_path)
+    leitor = arquivos.LeitorDoStore()
+    volta = leitor.ler_volta(raiz, "g#0008")
+    assert volta["disponivel"]
+    assert volta["gridIndex"] == [0, 1, 2, 3]
+    assert volta["elapsedS"] == [0.0, 10.0, 20.0, 30.0]
+    assert volta["lateralM"] == [0.0, 0.1, 0.2, 0.3]
+    assert volta["tempoS"] == 40.2 and volta["replayLapId"] == "rec__g__9" and volta["voltaDoJogo"] == 9
+    assert volta["passoM"] == 10.0 and volta["geometryId"] == "abc"
+    assert "outra" not in volta
+    # A segunda leitura vem da memoria, a mesma resposta.
+    assert leitor.ler_volta(raiz, "g#0008") is volta
+
+
+def test_volta_desconhecida_ou_id_invalido(tmp_path):
+    raiz = _repositorio(tmp_path)
+    leitor = arquivos.LeitorDoStore()
+    assert "não está no store" in leitor.ler_volta(raiz, "x#0001")["motivo"]
+    assert "inválido" in leitor.ler_volta(raiz, "../x")["motivo"]
+    assert leitor.ler_volta(None, "g#0008")["disponivel"] is False
+
+
+def test_geometria_exportada_sem_cache_fica_sem_relevo(tmp_path):
+    geo = arquivos.ler_geometria(_repositorio(tmp_path))
+    assert geo["disponivel"] and geo["geometryId"] == "abc"
+    assert geo["x"] == [0.0, 10.0, 10.0, 0.0] and geo["bordasDosMicrossetores"] == [0.0, 20.0, 40.0]
+    assert geo["elevacaoM"] is None and geo["relevo"].startswith("sem altitude")
+
+
+@pytest.mark.skipif(not (REPO / "data" / "ml" / "laps_grid_v2.parquet").exists(), reason="store v2 do repositório ausente")
+def test_volta_da_conferencia_nos_arquivos_reais():
+    """Pedido 30: a volta 8 de 05/10 20:33 e a volta da IA do coach, como o store v2 as guarda."""
+    leitor = arquivos.LeitorDoStore()
+    volta = leitor.ler_volta(REPO, "2026-10-05_20-33-47_vhe_interlagos#0008")
+    assert volta["disponivel"] and volta["pontosDaGrade"] == 2167 and len(volta["elapsedS"]) == 2167
+    assert volta["tempoS"] == pytest.approx(90.6288, abs=1e-3)
+    assert volta["replayLapId"] == "rec__2026-10-05_20-33-47_vhe_interlagos__9"
+    geo = arquivos.ler_geometria(REPO)
+    assert geo["geometryId"] == volta["geometryId"] == "0ed16f0dd2225990"
+    assert len(geo["x"]) == 2167 and len(geo["bordasDosMicrossetores"]) == 61
+    assert geo["elevacaoM"] is not None and len(geo["elevacaoM"]) == 2167
diff --git a/frontend/scripts/conferencia_prototipo.ts b/frontend/scripts/conferencia_prototipo.ts
new file mode 100644
index 00000000..d2076e10
--- /dev/null
+++ b/frontend/scripts/conferencia_prototipo.ts
@@ -0,0 +1,128 @@
+/**
+ * Conferência da tela Volta contra o protótipo A (pedido 30, seção 6).
+ *
+ *   node scripts/conferencia_prototipo.ts <url-do-backend> [saida.json]
+ *
+ * A volta 8 da sessão de 05/10 às 20:33 contra a volta da IA. Compara três
+ * fontes:
+ * - app: as linhas do store v2 lidas pelas rotas do app e as medidas de
+ *   `src/volta/medidas.ts` (o que a tela mostra);
+ * - protótipo: os números embutidos em `mockups/prototipo_dashboard.html`;
+ * - oficial: o `por_volta` do `sessao_2026-10-05-2.json`, que o
+ *   `atualizar_coach` gravou (só existe contra a volta da IA).
+ */
+import { readFileSync, writeFileSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import {
+  curvasDoRelatorio,
+  diferencaPorMicrossetor,
+  estadoDoFantasma,
+  medidasDasCurvas,
+  type Curva,
+  type Grade,
+  type Linhas,
+} from '../src/volta/medidas.ts';
+
+const base = process.argv[2];
+const destino = process.argv[3];
+if (!base) {
+  console.error('uso: node scripts/conferencia_prototipo.ts <url-do-backend> [saida.json]');
+  process.exit(2);
+}
+const VOLTA = '2026-10-05_20-33-47_vhe_interlagos#0008';
+const SESSAO = '2026-10-05-2';
+
+const pegar = async (rota: string) => {
+  const r = await fetch(`${base}${rota}`);
+  if (!r.ok) throw new Error(`${rota}: ${r.status}`);
+  return r.json();
+};
+
+const refs = await pegar('/api/coach/referencias');
+const idIA = refs.referencias.volta_ia.volta as string;
+const [sessao, volta, ia] = await Promise.all([
+  pegar(`/api/evolucao/sessoes/${SESSAO}`),
+  pegar(`/api/store/voltas/${encodeURIComponent(VOLTA)}`),
+  pegar(`/api/store/voltas/${encodeURIComponent(idIA)}`),
+]);
+
+const linhas = (v: any): Linhas => ({
+  elapsed: v.elapsedS, total: v.tempoS, velocidade: v.velocidadeKmh, acelerador: v.acelerador, freio: v.freio, lateral: v.lateralM,
+});
+const g: Grade = { n: volta.pontosDaGrade, comprimento: volta.comprimentoM, passo: volta.passoM };
+const curvas: Curva[] = curvasDoRelatorio(g, sessao.sessao.curvas);
+const geo = await pegar('/api/geometria/oficial');
+const bordas: number[] = geo.bordasDosMicrossetores;
+
+const app = medidasDasCurvas(g, linhas(volta), linhas(ia), curvas);
+const appMs = diferencaPorMicrossetor(g, linhas(volta), linhas(ia), bordas);
+
+// O protótipo A: os dados embutidos.
+const aqui = dirname(fileURLToPath(import.meta.url));
+const html = readFileSync(join(aqui, '..', 'mockups', 'prototipo_dashboard.html'), 'utf-8');
+const D = JSON.parse(/<script type="application\/json" id="dados">([\s\S]*?)<\/script>/.exec(html)![1]);
+const chave = `${VOLTA}|${D.ref.ia}`;
+const proto = D.cmp[chave];
+if (!proto) throw new Error(`o protótipo não tem ${chave}`);
+const pLap = D.laps[VOLTA];
+const pRef = D.laps[D.ref.ia];
+
+// O fantasma por curva do protótipo, com os dados dele (a mesma conta de `ghostState`).
+const S: number[] = D.step_s;
+const pInterp = (xs: number[], ys: number[], x: number) => {
+  if (x <= xs[0]) return ys[0];
+  for (let i = 1; i < xs.length; i += 1) if (x <= xs[i]) return ys[i - 1] + ((x - xs[i - 1]) / (xs[i] - xs[i - 1])) * (ys[i] - ys[i - 1]);
+  return ys[ys.length - 1];
+};
+const protoGhost = (s: number) => {
+  const c = curvas.find((k) => (k.trecho[1] >= k.trecho[0] ? s >= k.trecho[0] && s < k.trecho[1] : s >= k.trecho[0] || s < k.trecho[1]))!;
+  const [a, b] = c.trecho;
+  const s0 = b >= a ? a : s >= a ? a : 0;
+  const tme = pInterp(S, pLap.e, s);
+  return (tme - pInterp(S, pLap.e, s0)) - (pInterp(S, pRef.e, s) - pInterp(S, pRef.e, s0));
+};
+
+const oficial = Object.fromEntries(sessao.sessao.curvas.map((c: any) => [String(c.curva).split('-')[0], c.por_volta.find((p: any) => p.volta === VOLTA)]));
+const r3 = (v: number | null | undefined) => (v === null || v === undefined || !Number.isFinite(v) ? null : Math.round(v * 1000) / 1000);
+
+const linhasCurvas = curvas.map((c, i) => {
+  const fim = c.trecho[1] - 0.01 < 0 ? c.trecho[1] + g.comprimento - 0.01 : c.trecho[1] - 0.01;
+  const fantasmaApp = estadoDoFantasma(g, linhas(volta), linhas(ia), curvas, fim % g.comprimento, 'curva').diferenca;
+  return {
+    curva: c.codigo,
+    perda: { app: r3(app[i].perdaS), prototipo: r3(proto.c[i][0]), oficial: r3(oficial[c.codigo]?.perda_s) },
+    freadaM: { app: r3(app[i].freadaM), prototipo: proto.c[i][3], oficial: r3(oficial[c.codigo]?.frenagem_vs_ia_m) },
+    minimaKmh: { app: r3(app[i].minimaKmh), prototipo: proto.c[i][1], oficial: r3(oficial[c.codigo]?.velocidade_minima_vs_ia_kmh) },
+    lateralM: { app: r3(app[i].lateralApiceM), prototipo: proto.c[i][2], oficial: r3(oficial[c.codigo]?.lateral_apice_vs_ia_m) },
+    fantasmaNoFimDaCurva: { app: r3(fantasmaApp), prototipo: r3(protoGhost(fim % g.comprimento)) },
+  };
+});
+const maior = (f: (l: any) => number | null) => Math.max(...linhasCurvas.map((l) => Math.abs(f(l) ?? 0)));
+const msDif = appMs.map((v, i) => Math.abs(v - proto.ms[i]));
+
+const resultado = {
+  formato: 'conferencia-prototipo/1',
+  volta: VOLTA,
+  referencia: idIA,
+  tempo: { app: volta.tempoS, prototipo: pLap.t, refApp: ia.tempoS, refPrototipo: pRef.t },
+  diferencaDaVolta: { app: r3(volta.tempoS - ia.tempoS), prototipo: r3(pLap.t - pRef.t), somaDasCurvasApp: r3(app.reduce((a, c) => a + c.perdaS, 0)) },
+  curvas: linhasCurvas,
+  microssetores: appMs.map((v, i) => ({ microssetor: i + 1, app: Math.round(v * 10000) / 10000, prototipo: proto.ms[i] })),
+  maioresDiferencas: {
+    perdaAppPrototipoS: r3(maior((l) => (l.perda.app ?? 0) - (l.perda.prototipo ?? 0))),
+    perdaAppOficialS: r3(maior((l) => (l.perda.app ?? 0) - (l.perda.oficial ?? 0))),
+    freadaAppOficialM: r3(maior((l) => (l.freadaM.app ?? 0) - (l.freadaM.oficial ?? 0))),
+    minimaAppOficialKmh: r3(maior((l) => (l.minimaKmh.app ?? 0) - (l.minimaKmh.oficial ?? 0))),
+    lateralAppOficialM: r3(maior((l) => (l.lateralM.app ?? 0) - (l.lateralM.oficial ?? 0))),
+    microssetorAppPrototipoS: r3(Math.max(...msDif)),
+    fantasmaAppPrototipoS: r3(maior((l) => (l.fantasmaNoFimDaCurva.app ?? 0) - (l.fantasmaNoFimDaCurva.prototipo ?? 0))),
+  },
+};
+console.log(JSON.stringify(resultado.maioresDiferencas, null, 2));
+console.log(JSON.stringify({ tempo: resultado.tempo, diferencaDaVolta: resultado.diferencaDaVolta }, null, 2));
+for (const l of linhasCurvas) console.log(l.curva, JSON.stringify(l.perda), JSON.stringify(l.freadaM), JSON.stringify(l.fantasmaNoFimDaCurva));
+if (destino) {
+  writeFileSync(destino, JSON.stringify(resultado, null, 2) + '\n', 'utf-8');
+  console.log(`gravado em ${destino}`);
+}
