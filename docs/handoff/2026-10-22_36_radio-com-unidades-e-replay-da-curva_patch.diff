diff --git a/desktop/log-rotativo.js b/desktop/log-rotativo.js
new file mode 100644
index 00000000..0ad1c125
--- /dev/null
+++ b/desktop/log-rotativo.js
@@ -0,0 +1,80 @@
+// O log do backend com tamanho máximo (pedido 36).
+//
+// Antes, o `main.js` acrescentava a saída do backend em `logs/backend.log` para sempre: um
+// erro em laço (04/10/2026) deixou o arquivo com 3,8 GB. Agora, quando o arquivo passaria de
+// `maxBytes`, ele vira `backend.1.log`, o `.1` vira `.2`, e assim até `arquivos`; o mais velho
+// sai. O máximo no disco fica em cerca de (arquivos + 1) × maxBytes.
+//
+// A conferência é feita a cada escrita, e não só no arranque: um erro em laço gira o arquivo
+// na hora, em vez de encher o disco até o próximo arranque.
+const fs = require('node:fs');
+const path = require('node:path');
+const { Writable } = require('node:stream');
+
+const MAX_BYTES_PADRAO = 20 * 1024 * 1024;
+const ARQUIVOS_PADRAO = 5;
+
+function nomeGirado(caminho, n) {
+  const ext = path.extname(caminho);
+  return path.join(path.dirname(caminho), `${path.basename(caminho, ext)}.${n}${ext}`);
+}
+
+// backend.log → backend.1.log, backend.1.log → backend.2.log, ...; o de número `arquivos` sai.
+function girar(caminho, arquivos = ARQUIVOS_PADRAO) {
+  fs.rmSync(nomeGirado(caminho, arquivos), { force: true });
+  for (let n = arquivos - 1; n >= 1; n -= 1) {
+    const de = nomeGirado(caminho, n);
+    if (fs.existsSync(de)) fs.renameSync(de, nomeGirado(caminho, n + 1));
+  }
+  if (fs.existsSync(caminho)) fs.renameSync(caminho, nomeGirado(caminho, 1));
+}
+
+function tamanhoDe(caminho) {
+  try {
+    return fs.statSync(caminho).size;
+  } catch {
+    return 0;
+  }
+}
+
+class LogRotativo extends Writable {
+  constructor(caminho, { maxBytes = MAX_BYTES_PADRAO, arquivos = ARQUIVOS_PADRAO, avisar = () => {} } = {}) {
+    super();
+    this.caminho = caminho;
+    this.maxBytes = maxBytes;
+    this.arquivos = arquivos;
+    this.avisar = avisar;
+    this.tamanho = tamanhoDe(caminho);
+    this.avisou = false;
+    // No arranque, um arquivo que já passou do limite (o de 3,8 GB) gira antes da primeira linha.
+    if (this.tamanho > this.maxBytes) this._girar();
+  }
+
+  _girar() {
+    try {
+      girar(this.caminho, this.arquivos);
+      this.tamanho = 0;
+      this.avisou = false;
+    } catch (erro) {
+      // Um arquivo preso por outro programa não para o backend: o log segue no mesmo arquivo
+      // e tenta girar de novo na próxima escrita (o aviso sai uma vez só).
+      if (!this.avisou) this.avisar(`Não consegui girar ${this.caminho}: ${erro.message}`);
+      this.avisou = true;
+    }
+  }
+
+  _write(pedaco, codificacao, pronto) {
+    const dados = Buffer.isBuffer(pedaco) ? pedaco : Buffer.from(pedaco, codificacao);
+    if (this.tamanho > 0 && this.tamanho + dados.length > this.maxBytes) this._girar();
+    fs.appendFile(this.caminho, dados, (erro) => {
+      if (!erro) this.tamanho += dados.length;
+      pronto(erro);
+    });
+  }
+}
+
+function criarLogRotativo(caminho, opcoes) {
+  return new LogRotativo(caminho, opcoes);
+}
+
+module.exports = { criarLogRotativo, girar, nomeGirado, MAX_BYTES_PADRAO, ARQUIVOS_PADRAO };
diff --git a/desktop/log-rotativo.test.js b/desktop/log-rotativo.test.js
new file mode 100644
index 00000000..8001d0e3
--- /dev/null
+++ b/desktop/log-rotativo.test.js
@@ -0,0 +1,67 @@
+// node --test (na pasta desktop): a rotação do log do backend (pedido 36).
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const test = require('node:test');
+const { criarLogRotativo, nomeGirado } = require('./log-rotativo');
+
+function pastaNova() {
+  return fs.mkdtempSync(path.join(os.tmpdir(), 'log-rotativo-'));
+}
+
+function escrever(log, texto) {
+  return new Promise((ok, falha) => log.write(texto, (erro) => (erro ? falha(erro) : ok())));
+}
+
+test('gira quando o arquivo passaria do limite e guarda só os 5 mais novos', async () => {
+  const pasta = pastaNova();
+  const caminho = path.join(pasta, 'backend.log');
+  const log = criarLogRotativo(caminho, { maxBytes: 100, arquivos: 5 });
+  for (let i = 0; i < 40; i += 1) await escrever(log, `linha ${String(i).padStart(2, '0')} ${'x'.repeat(30)}\n`); // 40 bytes cada
+  const nomes = fs.readdirSync(pasta).sort();
+  assert.deepEqual(nomes, ['backend.1.log', 'backend.2.log', 'backend.3.log', 'backend.4.log', 'backend.5.log', 'backend.log']);
+  for (const nome of nomes) assert.ok(fs.statSync(path.join(pasta, nome)).size <= 100, nome);
+  // Nenhuma linha cortada ao meio, e o mais novo fica no backend.log.
+  const atual = fs.readFileSync(caminho, 'utf8');
+  assert.match(atual, /^(linha \d\d x{30}\n)+$/);
+  assert.match(atual, /linha 39/);
+  assert.match(fs.readFileSync(nomeGirado(caminho, 1), 'utf8'), /^(linha \d\d x{30}\n)+$/);
+  // 6 arquivos de 2 linhas: as 12 mais novas ficam; a 27 e as anteriores saíram.
+  const tudo = nomes.map((n) => fs.readFileSync(path.join(pasta, n), 'utf8')).join('');
+  assert.doesNotMatch(tudo, /linha 27/);
+  assert.match(tudo, /linha 28/);
+});
+
+test('no arranque, um arquivo que já passou do limite gira antes da primeira linha', async () => {
+  const pasta = pastaNova();
+  const caminho = path.join(pasta, 'backend.log');
+  fs.writeFileSync(caminho, 'velho\n'.repeat(50));
+  const log = criarLogRotativo(caminho, { maxBytes: 100 });
+  await escrever(log, 'novo\n');
+  assert.equal(fs.readFileSync(caminho, 'utf8'), 'novo\n');
+  assert.equal(fs.readFileSync(nomeGirado(caminho, 1), 'utf8'), 'velho\n'.repeat(50));
+});
+
+test('abaixo do limite, continua acrescentando no mesmo arquivo', async () => {
+  const pasta = pastaNova();
+  const caminho = path.join(pasta, 'backend.log');
+  fs.writeFileSync(caminho, 'de antes\n');
+  const log = criarLogRotativo(caminho);
+  await escrever(log, 'de agora\n');
+  assert.equal(fs.readFileSync(caminho, 'utf8'), 'de antes\nde agora\n');
+  assert.equal(fs.readdirSync(pasta).length, 1);
+});
+
+test('se não der para girar, avisa e segue escrevendo', async () => {
+  const pasta = pastaNova();
+  const caminho = path.join(pasta, 'backend.log');
+  const avisos = [];
+  const log = criarLogRotativo(caminho, { maxBytes: 10, avisar: (m) => avisos.push(m) });
+  fs.mkdirSync(path.join(nomeGirado(caminho, 5), 'dentro'), { recursive: true }); // uma pasta no lugar do backend.5.log: não sai
+  await escrever(log, '0123456789\n');
+  await escrever(log, 'mais uma\n');
+  await escrever(log, 'e outra\n');
+  assert.equal(fs.readFileSync(caminho, 'utf8'), '0123456789\nmais uma\ne outra\n');
+  assert.equal(avisos.length, 1);
+});
