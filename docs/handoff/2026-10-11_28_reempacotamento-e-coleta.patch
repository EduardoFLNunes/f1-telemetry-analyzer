index 00000000..6ae92718
--- /dev/null
+++ b/backend/core/coleta/oficial.py
@@ -0,0 +1,118 @@
+"""A contagem oficial da M1, lida do store v2 (pedido 28, Parte D.3).
+
+A regra e a da secao 6 de `docs/modelo_fisico_m0.md`, a mesma da previa da aba
+(`core.coleta.conferencia.veredito_m1`), aplicada ao store v2 que o
+`atualizar_coach` refaz:
+
+* uma sessao e humana quando todas as voltas dela no store tem `origem` igual a
+  `humano` (o rotulo final do store, venha ele do indicador ou de anotacao);
+* ela conta quando a guinada e as velocidades no referencial do carro estao em
+  pelo menos 95% dos pontos da grade das voltas dela no store.
+
+So le `data/ml/laps_grid_v2.parquet` (as colunas da regra) e o meta. O nome dos
+arquivos e o de `ml.data.store_v2`, que nao e importado aqui porque puxa o
+torch; um teste confere os nomes.
+"""
+
+from __future__ import annotations
+
+import json
+import threading
+from pathlib import Path
+from typing import Any, Dict, Optional, Tuple
+
+import numpy as np
+import pandas as pd
+
+from .requisitos import COLUNAS_M1, NOME_M1, PREENCHIMENTO_M1, SESSOES_M1
+
+STORE_V2_FILENAME = "laps_grid_v2.parquet"
+STORE_V2_METADATA = "laps_grid_v2_meta.json"
+HUMANO = "humano"
+
+_cache: Dict[Tuple[str, float, int, float], Dict[str, Any]] = {}
+_lock = threading.Lock()
+
+
+def _arquivos(repositorio: Path) -> Tuple[Path, Path]:
+    pasta = Path(repositorio) / "data" / "ml"
+    return pasta / STORE_V2_FILENAME, pasta / STORE_V2_METADATA
+
+
+def contagem_oficial(repositorio: Optional[Path]) -> Dict[str, Any]:
+    if repositorio is None:
+        return {"disponivel": False, "motivo": "o caminho do repositório não está configurado"}
+    parquet, meta_path = _arquivos(repositorio)
+    if not parquet.exists() or not meta_path.exists():
+        return {"disponivel": False, "motivo": f"store v2 não encontrado em {parquet.parent}"}
+    info, info_meta = parquet.stat(), meta_path.stat()
+    chave = (str(parquet), info.st_mtime, info.st_size, info_meta.st_mtime)
+    with _lock:
+        if chave in _cache:
+            return dict(_cache[chave])
+    resultado = _contar(parquet, meta_path)
+    with _lock:
+        _cache.clear()
+        _cache[chave] = resultado
+    return dict(resultado)
+
+
+def _contar(parquet: Path, meta_path: Path) -> Dict[str, Any]:
+    meta = json.loads(meta_path.read_text(encoding="utf-8"))
+    voltas = pd.DataFrame(meta.get("laps") or [])
+    grade = int(meta.get("grid_size") or 0)
+    if voltas.empty or not grade:
+        return {"disponivel": False, "motivo": "o store v2 não tem voltas"}
+    colunas = [c for c in COLUNAS_M1 if c in (meta.get("columns") or [])]
+    frame = pd.read_parquet(parquet, columns=["lap_id", *colunas])
+    preenchidos = frame.groupby("lap_id")[colunas].count() if colunas else pd.DataFrame(index=voltas["lap_id"])
+
+    sessoes = []
+    for session_id, grupo in voltas.groupby("session_id", sort=True):
+        ids = grupo["lap_id"].tolist()
+        origens = grupo["origem"].fillna("desconhecida").tolist() if "origem" in grupo else []
+        fontes = sorted({str(f) for f in grupo.get("origem_fonte", pd.Series(dtype=object)).dropna()})
+        humana = bool(origens) and all(o == HUMANO for o in origens)
+        if not any(o == HUMANO for o in origens):
+            continue
+        total = len(ids) * grade
+        preenchimento = {}
+        for coluna in COLUNAS_M1:
+            if coluna in preenchidos.columns:
+                preenchimento[coluna] = float(preenchidos.reindex(ids)[coluna].fillna(0).sum()) / total
+            else:
+                preenchimento[coluna] = 0.0
+        faltando = [c for c in COLUNAS_M1 if preenchimento[c] < PREENCHIMENTO_M1]
+        motivos = []
+        if not humana:
+            motivos.append("tem voltas que não são suas no store")
+        if faltando:
+            motivos.append("abaixo de 95%: " + ", ".join(NOME_M1[c] for c in faltando))
+        sessoes.append({
+            "sessao": session_id,
+            "voltasNoStore": len(ids),
+            "origens": {o: origens.count(o) for o in sorted(set(origens))},
+            "fontesDaOrigem": fontes,
+            "humana": humana,
+            "preenchimentoGrade": {k: round(v, 4) for k, v in preenchimento.items()},
+            "conta": humana and not faltando,
+            "motivos": motivos,
+        })
+    contam = [s for s in sessoes if s["conta"]]
+    return {
+        "disponivel": True,
+        "n": len(contam),
+        "meta": SESSOES_M1,
+        "texto": f"{len(contam)} de {SESSOES_M1}",
+        "sessoesQueContam": [s["sessao"] for s in contam],
+        "sessoesComVoltasSuas": sessoes,
+        "store": {
+            "arquivo": str(parquet),
+            "construidoEm": meta.get("construido_em"),
+            "commit": meta.get("commit"),
+            "esquema": meta.get("esquema"),
+            "voltas": int(len(voltas)),
+        },
+        "regra": "sessões com todas as voltas do store como suas (origem humano) e a guinada e as velocidades "
+                 "no referencial do carro em pelo menos 95% dos pontos da grade",
+    }
diff --git a/backend/core/coleta/origem_app.py b/backend/core/coleta/origem_app.py
new file mode 100644
index 00000000..7692d69e
--- /dev/null
+++ b/backend/core/coleta/origem_app.py
@@ -0,0 +1,82 @@
+"""Qual app gravou a sessao: a versao e o commit (pedido 28, Parte C.4).
+
+No app instalado, o Electron passa o carimbo do build (`build-info.json`) nas
+variaveis `AT_APP_*`. Rodando do codigo-fonte, o backend pergunta ao git do
+repositorio, e diz se a arvore tinha mudancas nao commitadas.
+
+Vai para o `metadata.json` de cada sessao nova (`appVersion`, `appCommit`,
+`appCommitDirty`, `appPackaged`), ao lado dos campos que ja existiam.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+from pathlib import Path
+from typing import Any, Dict, Optional
+
+_cache: Optional[Dict[str, Any]] = None
+
+
+def _flag(value: Optional[str]) -> Optional[bool]:
+    if value is None or value == "":
+        return None
+    return value.strip().lower() in ("1", "true", "yes", "on")
+
+
+def _git(args, cwd: Path) -> Optional[str]:
+    try:
+        out = subprocess.run(["git", *args], cwd=str(cwd), capture_output=True, text=True, timeout=10,
+                             creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
+    except (OSError, subprocess.SubprocessError):
+        return None
+    return out.stdout.strip() if out.returncode == 0 else None
+
+
+def app_identity(repo_root: Path, refresh: bool = False) -> Dict[str, Any]:
+    """{"versao", "commit", "commitCurto", "arvoreSuja", "empacotado", "fonte", "construidoEm"}."""
+    global _cache
+    if _cache is not None and not refresh:
+        return dict(_cache)
+    version = os.environ.get("AT_APP_VERSION")
+    commit = os.environ.get("AT_APP_COMMIT")
+    if version or commit:
+        identity = {
+            "versao": version or None,
+            "commit": commit or None,
+            "arvoreSuja": _flag(os.environ.get("AT_APP_BUILD_DIRTY")),
+            "empacotado": bool(_flag(os.environ.get("AT_APP_PACKAGED"))),
+            "fonte": "build-info",
+            "construidoEm": os.environ.get("AT_APP_BUILT_AT") or None,
+        }
+    else:
+        root = Path(repo_root)
+        version = None
+        try:
+            version = json.loads((root / "desktop" / "package.json").read_text(encoding="utf-8")).get("version")
+        except (OSError, json.JSONDecodeError):
+            pass
+        status = _git(["status", "--porcelain"], root)
+        identity = {
+            "versao": version,
+            "commit": _git(["rev-parse", "HEAD"], root),
+            "arvoreSuja": None if status is None else bool(status),
+            "empacotado": False,
+            "fonte": "git",
+            "construidoEm": None,
+        }
+    identity["commitCurto"] = identity["commit"][:7] if identity.get("commit") else None
+    _cache = identity
+    return dict(identity)
+
+
+def metadata_fields(repo_root: Path) -> Dict[str, Any]:
+    """Os campos novos do `metadata.json`."""
+    identity = app_identity(repo_root)
+    return {
+        "appVersion": identity["versao"],
+        "appCommit": identity["commit"],
+        "appCommitDirty": identity["arvoreSuja"],
+        "appPackaged": identity["empacotado"],
+    }
diff --git a/backend/core/coleta/requisitos.py b/backend/core/coleta/requisitos.py
new file mode 100644
index 00000000..c9dfa4f0
--- /dev/null
+++ b/backend/core/coleta/requisitos.py
@@ -0,0 +1,622 @@
+"""O que os modelos precisam que a gravacao tenha (pedido 28, Parte B).
+
+Uma lista so. A aba "Coleta de dados", a conferencia de fim de sessao e os
+testes leem daqui; o front nao copia nada a mao.
+
+Cada item diz:
+
+* onde o valor esta no que o gravador escreve (`componentes`: um caminho por
+  roda ou eixo, com os formatos antigos como alternativa) e de que parte da
+  linha ele vem (`fonte`: a amostra, o envelope ou o `metadata.json`);
+* a coluna do achatamento do ML (`ml.data.samples.flatten`), quando existe, e
+  as colunas do store v2 que saem dele;
+* quem usa: coach, store v2 e LSTM, origem da volta, limites de pista, modelo do
+  carro (M1) e o bloco `tecnica` do relatorio de evolucao;
+* a unidade, a faixa plausivel, o preenchimento minimo e se ele e obrigatorio
+  na regra da M1 (`docs/modelo_fisico_m0.md`, secao 6).
+
+**As faixas.** Onde o inventario do pedido 18
+(`docs/handoff/2026-10-04_canais-fisicos_inventario.json`, sessao de 04/10 do
+repositorio, 447.811 amostras) mediu o campo, a faixa e
+`[p1 - m, p99 + m]`, com a margem `m = 0,5 x (p99 - p1)`, cortada nos limites
+fisicos do item (pedal entre 0 e 1, temperatura e carga nao negativas). O p1 e
+o p99 ficam copiados aqui (`p1_p99`) porque o backend empacotado nao le `docs/`;
+um teste confere a copia contra o JSON. Onde o inventario nao mediu (os canais
+que o gravador so passou a gravar no pedido 18, e os de base que ele nao
+listou), a faixa e um limite fisico com folga, e `fonte_faixa` diz isso.
+
+**O preenchimento minimo.** Os cinco canais do portao de qualidade
+(`ml.config.REQUIRED_CHANNELS`) usam o limiar do proprio portao, 90%. Os outros,
+95%, o limiar das checagens do pedido 18, que e tambem o da regra da M1.
+
+Este modulo nao importa `ml`: o backend empacotado le daqui sem levar o pacote
