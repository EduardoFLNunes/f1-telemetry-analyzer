+  return (
+    <div style={{ display: 'flex', gap: 10, alignItems: 'center', padding: '10px 12px', borderRadius: 4, border: `1px solid ${COR_DO_TOM[tom]}55`, background: `${COR_DO_TOM[tom]}12` }}>
