+"""Signed lateral offset of the car from the centerline, and its sign convention.
+
+Two conventions exist in the project, and they are opposite:
+
+* the runtime (this module) uses `normal = (-t_z, t_x)` in the world X/Z
+  plane, which points to the driver's **right**. `lateralOffset`, `lateral_offset`
+  and `L` in every recorded sample are therefore positive to the right;
+* the offline `ml` pipeline measures `lateral` against a normal that points to
+  the driver's **left** (verified against the track: its first detected corner
+  after the line, at s ~ 300 m, comes out left-handed, as the S do Senna is).
+
+Measured on recordings from May, June and August 2026: the recorded offset and
+the `ml` lateral correlate at -0.95 to -0.99, and |ml + recorded| stays under
+0.51 m at the 95th percentile -- the residue is the `ml` centerline smoothing,
+not a sign problem.
+
+The runtime convention is kept as it is: 11 GB of recordings already carry it,
+and every runtime consumer either takes `abs()` or subtracts two offsets of the
+same convention. What changes is that nothing converts by assumption any more:
+`to_left_positive` is the one place that crosses from one to the other.
+"""
+
 import numpy as np
 from typing import Tuple
 
+# Side of the track a positive recorded offset is on, as seen by the driver.
+RECORDED_OFFSET_POSITIVE_SIDE = "right"
+
 
 def normalize(vector: np.ndarray) -> np.ndarray:
     norm = float(np.linalg.norm(vector))
@@ -17,3 +42,10 @@ def tangent_and_normal(segment_vector: np.ndarray) -> Tuple[np.ndarray, np.ndarr
 
 def signed_lateral_offset(world_point: np.ndarray, projected_point: np.ndarray, normal: np.ndarray) -> float:
     return float(np.dot(world_point - projected_point, normal))
+
+
+def to_left_positive(recorded_offset):
+    """Recorded (right-positive) offset -> left-positive, the `ml` convention."""
+    if recorded_offset is None:
+        return None
+    return -recorded_offset
diff --git a/backend/core/telemetry/channels.py b/backend/core/telemetry/channels.py
new file mode 100644
index 00000000..ce6c114d
--- /dev/null
+++ b/backend/core/telemetry/channels.py
@@ -0,0 +1,85 @@
+"""Where a recorded sample keeps the driver's inputs, across recorder versions.
+
+Three schemas are on disk, and a reader that knows only one of them returns
+zeros for the others without raising:
+
+* up to mid-June 2026: inputs at the top of the sample (`sample.throttle`,
+  `sample.brake`, `sample.steering`, `sample.gear`, `sample.rpm`), no
+  `carPhysics` block -- e.g. `2026-06-14_12-23-46`;
+* from late May on: both places, with identical values (measured: maximum
+  difference 0.0 over 120 000 samples in four sessions);
+* `2026-08-09_*`: only `carPhysics.controls` (`steerAngle` instead of
+  `steering`), nothing at the top.
+
+The nested block wins when it carries a value because it is the newer schema;
+the top level fills in when it does not. Both callers -- the runtime's assisted
+analysis and the offline `ml` pipeline -- read through `driver_inputs`, so the
+rule lives in one place.
+"""
+
+from __future__ import annotations
+
+import math
+from typing import Any, Dict, Mapping, Optional
+
+# Canonical name -> (key in `carPhysics.controls`, key at the top of the sample).
+INPUT_CHANNELS: Dict[str, tuple] = {
+    "throttle": ("throttle", "throttle"),
+    "brake": ("brake", "brake"),
+    "clutch": ("clutch", "clutch"),
+    "steering": ("steerAngle", "steering"),
+    "gear": ("gear", "gear"),
+    "rpm": ("rpm", "rpm"),
+}
+
+
+def _finite(value: Any) -> Optional[float]:
+    if value is None or isinstance(value, bool):
+        return None
+    try:
+        result = float(value)
+    except (TypeError, ValueError):
+        return None
+    return result if math.isfinite(result) else None
+
+
+def _controls(sample: Mapping[str, Any]) -> Mapping[str, Any]:
+    physics = sample.get("carPhysics")
+    if not isinstance(physics, Mapping):
+        return {}
+    controls = physics.get("controls")
+    return controls if isinstance(controls, Mapping) else {}
+
+
+def driver_inputs(sample: Mapping[str, Any]) -> Dict[str, Optional[float]]:
+    """Throttle, brake, clutch, steering, gear and rpm of one sample.
+
+    `sample` is the inner `sample` object of a `player.jsonl` line (an envelope
+    is unwrapped too). A channel no schema carries comes back as None, never
+    0.0: "not recorded" and "pedal released" are different facts.
+    """
+    if isinstance(sample.get("sample"), Mapping):
+        sample = sample["sample"]
+    controls = _controls(sample)
+    out: Dict[str, Optional[float]] = {}
+    for name, (nested_key, top_key) in INPUT_CHANNELS.items():
+        value = _finite(controls.get(nested_key))
+        if value is None:
+            value = _finite(sample.get(top_key))
+        out[name] = value
+    return out
+
+
+def input_schema(sample: Mapping[str, Any]) -> str:
+    """Which schema a sample uses: `nested`, `top_level`, `both` or `none`."""
+    if isinstance(sample.get("sample"), Mapping):
+        sample = sample["sample"]
+    nested = _finite(_controls(sample).get("throttle")) is not None
+    top = _finite(sample.get("throttle")) is not None
+    if nested and top:
+        return "both"
+    if nested:
+        return "nested"
+    if top:
+        return "top_level"
+    return "none"
