diff --git a/backend/ml/scripts/checar_canais_fisicos.py b/backend/ml/scripts/checar_canais_fisicos.py
new file mode 100644
index 00000000..97a1b6e7
--- /dev/null
+++ b/backend/ml/scripts/checar_canais_fisicos.py
@@ -0,0 +1,133 @@
+"""Checagens da M0 no store v2 (pedido 18, Parte C; docs/modelo_fisico_m0.md, secao 1.2).
+
+    python -m ml.scripts.checar_canais_fisicos --base DIR [--saida ARQUIVO]
+
+`--base` e a pasta com a copia do store v2 do inicio da etapa
+(`laps_grid_v2.parquet` e o meta). Confere:
+
+* **nada do que ja existe muda** -- as mesmas voltas, o mesmo `lap_time_s` e as
+  colunas antigas identicas valor a valor (NaN igual a NaN);
+* **canais novos preenchidos** -- na sessao `2026-10-04`, cada canal novo cujo
+  campo existe na gravacao tem pelo menos 95% dos pontos da grade
+  preenchidos; a sessao `2026-10-05` (app instalado) e relatada a parte;
+* **store integro** -- o meta do store novo traz as checagens do pedido 16
+  aprovadas.
+
+Sai com codigo 2 se alguma coluna antiga mudou.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+from typing import Dict, List
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+import numpy as np  # noqa: E402
+import pandas as pd  # noqa: E402
+
+from ml import config  # noqa: E402
+from ml.comparison.evolution import group_sessions  # noqa: E402
+from ml.data.lap_store import StoredLaps  # noqa: E402
+from ml.data.store_v2 import PHYSICAL_COLUMNS, load_store_v2, store_v2_meta  # noqa: E402
+
+FILL_LIMIT = 0.95
+CHECKED_SESSION = "2026-10-04"
+SEPARATE_SESSION = "2026-10-05"
+
+
+def unchanged(new: StoredLaps, base: StoredLaps) -> Dict[str, object]:
+    """As voltas, os tempos e as colunas do store base, iguais no novo."""
+    base_ids, new_ids = set(base.lap_ids), set(new.lap_ids)
+    times_base = base.laps.set_index("lap_id")["lap_time_s"]
+    times_new = new.laps.set_index("lap_id")["lap_time_s"]
+    common = sorted(base_ids & new_ids)
+    time_diff = [i for i in common if float(times_base[i]) != float(times_new[i])]
+    old_columns = [c for c in base.frame.columns if c not in ("lap_id", "grid_index")]
+    a = base.frame.sort_values(["lap_id", "grid_index"]).reset_index(drop=True)
+    b = new.frame[new.frame["lap_id"].isin(base_ids)].sort_values(["lap_id", "grid_index"]).reset_index(drop=True)
+    changed: List[str] = []
+    missing = [c for c in old_columns if c not in b.columns]
+    if len(a) != len(b) or not (a["lap_id"].to_numpy() == b["lap_id"].to_numpy()).all():
+        changed.append("(linhas da grade)")
+    else:
+        for column in old_columns:
+            if column in missing:
+                continue
+            if not np.array_equal(a[column].to_numpy(dtype=float), b[column].to_numpy(dtype=float), equal_nan=True):
+                changed.append(column)
+    return {
+        "checagem": "nada do que ja existe muda",
+        "voltas_base": len(base_ids), "voltas_novo": len(new_ids),
+        "so_na_base": sorted(base_ids - new_ids), "so_no_novo": sorted(new_ids - base_ids),
+        "lap_time_s_diferente": time_diff,
+        "colunas_antigas": old_columns,
+        "colunas_ausentes": missing,
+        "colunas_mudadas": changed,
+        "passou": base_ids == new_ids and not time_diff and not changed and not missing,
+    }
+
+
+def fill(store: StoredLaps, lap_ids: List[str]) -> Dict[str, object]:
+    """Preenchimento de cada canal novo nas voltas dadas, e se o campo existe na gravacao."""
+    frame = store.frame[store.frame["lap_id"].isin(lap_ids)]
+    out = {}
+    for column in PHYSICAL_COLUMNS:
+        values = frame[column].to_numpy(dtype=float) if column in frame else np.array([])
+        finite = np.isfinite(values)
+        out[column] = {
+            "existe_na_gravacao": bool(finite.any()),
+            "preenchimento": round(float(finite.mean()), 4) if values.size else 0.0,
+        }
+    return out
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--base", type=Path, required=True)
+    parser.add_argument("--saida", type=Path, default=config.artifacts_root() / "canais" / "checagens_store_m0.json")
+    args = parser.parse_args(argv)
+
+    new = load_store_v2()
+    base = load_store_v2(args.base)
+    meta = store_v2_meta()
+    sessions = group_sessions({sid: p for sid, p in (meta.get("periodos_das_gravacoes") or {}).items()})
+    laps = new.laps.assign(sessao=new.laps["session_id"].map(sessions))
+    by_session = {key: laps.loc[laps["sessao"] == key, "lap_id"].tolist() for key in (CHECKED_SESSION, SEPARATE_SESSION)}
+
+    result: Dict[str, object] = {"esquema": meta.get("esquema"), "nada_muda": unchanged(new, base)}
+    checked = fill(new, by_session[CHECKED_SESSION])
+    existing = {c: v for c, v in checked.items() if v["existe_na_gravacao"]}
+    result["preenchimento"] = {
+        "checagem": f"canais novos com pelo menos {FILL_LIMIT:.0%} preenchidos na sessao {CHECKED_SESSION}",
+        "voltas": len(by_session[CHECKED_SESSION]),
+        "canais": checked,
+        "abaixo_do_limite": [c for c, v in existing.items() if v["preenchimento"] < FILL_LIMIT],
+        "passou": bool(existing) and all(v["preenchimento"] >= FILL_LIMIT for v in existing.values()),
+    }
+    result[f"sessao_{SEPARATE_SESSION}_a_parte"] = {"voltas": len(by_session[SEPARATE_SESSION]),
+                                                    "canais": fill(new, by_session[SEPARATE_SESSION])}
+    result["store_integro"] = {"checagem": "checagens do pedido 16", "aprovado": bool(meta.get("aprovado")),
+                               "passou": bool(meta.get("aprovado"))}
+    result["canais_por_volta"] = {"voltas_com_algum_canal_novo": sum(1 for v in (meta.get("canais_por_volta") or {}).values() if v)}
+    args.saida.parent.mkdir(parents=True, exist_ok=True)
+    args.saida.write_text(json.dumps(result, indent=1, ensure_ascii=False), encoding="utf-8")
+
+    for key in ("nada_muda", "preenchimento", "store_integro"):
+        print(f"[{'ok' if result[key]['passou'] else 'FALHOU'}] {result[key]['checagem']}")
+    if result["nada_muda"]["colunas_mudadas"] or result["nada_muda"]["colunas_ausentes"]:
+        print(f"   colunas mudadas: {result['nada_muda']['colunas_mudadas']}  ausentes: {result['nada_muda']['colunas_ausentes']}")
+    for column, value in checked.items():
+        print(f"   {CHECKED_SESSION} {column:20s} existe={value['existe_na_gravacao']}  {value['preenchimento']:.3f}")
+    print(f"-> {args.saida}")
+    if not result["nada_muda"]["passou"]:
+        print("PARADO: uma coluna antiga mudou (ou as voltas mudaram).")
+        return 2
+    return 0 if all(result[k]["passou"] for k in ("preenchimento", "store_integro")) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/backend/ml/scripts/inventario_canais.py b/backend/ml/scripts/inventario_canais.py
new file mode 100644
index 00000000..43138a78
--- /dev/null
+++ b/backend/ml/scripts/inventario_canais.py
@@ -0,0 +1,185 @@
+"""Inventario dos canais fisicos nas gravacoes (pedido 18, Parte B; ADR 0017, M0).
+
+    python -m ml.scripts.inventario_canais [--sessoes 2026-10-04 2026-10-05] [--saida ARQUIVO]
+
+Para cada campo da lista do pedido 18 (pneus, freios, movimento, suspensao,
+comandos), nas gravacoes das sessoes dadas e separado por app (o de
+desenvolvimento grava em `data/recordings`; o instalado, em `%APPDATA%`):
+se existe na amostra gravada, a fracao de amostras preenchidas, a faixa
+(p1, p50, p99) e a unidade provavel. As sessoes seguem a regra da emenda de
+05/10 (`evolution.group_sessions`), sobre o inventario rotulado.
+
+Um campo que o adaptador le da memoria compartilhada mas nao grava aparece
+como `gravado: false`, com a nota de onde ele esta na estrutura.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+from typing import Dict, List, Optional
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+import numpy as np  # noqa: E402
+import pandas as pd  # noqa: E402
+
+from ml import config  # noqa: E402
+from ml.comparison.evolution import group_sessions  # noqa: E402
+from ml.data.origin import recording_folder  # noqa: E402
+from ml.data.recordings import list_all_sessions  # noqa: E402
+from ml.data.store_v2 import default_inventory_path, recording_periods  # noqa: E402
+
+# (grupo, campo, caminho na amostra gravada ou None, unidade provavel, nota)
+FIELDS = (
+    ("pneus", "tyreCoreTemperature", "carPhysics.tyres.tyreCoreTemperature", "°C", ""),
+    ("pneus", "tyreTempI", None, "°C", "temperatura interna; lida pelo adaptador, nao gravada"),
+    ("pneus", "tyreTempM", None, "°C", "temperatura central; lida pelo adaptador, nao gravada"),
+    ("pneus", "tyreTempO", None, "°C", "temperatura externa; lida pelo adaptador, nao gravada"),
+    ("pneus", "tyrePressure", "carPhysics.tyres.tyrePressure", "psi", "wheelsPressure na memoria"),
+    ("pneus", "tyreWear", "carPhysics.tyres.tyreWear", "% (100 = novo)", ""),
+    ("pneus", "wheelSlip", "carPhysics.tyres.wheelSlip", "adimensional (escorregamento do jogo)", ""),
+    ("pneus", "wheelLoad", "carPhysics.tyres.wheelLoad", "N", ""),
+    ("freios", "brakeTemp", None, "°C",
+     "existe na memoria; o adaptador le no deslocamento errado (le brakeBias e localVelocity) e nao grava"),
+    ("freios", "brakeBias", None, "fracao na dianteira",
+     "existe na memoria; o adaptador nao declara no lugar certo e nao grava"),
+    ("movimento", "localVelocity", None, "m/s (x lateral, y vertical, z longitudinal)",
+     "existe na memoria; o adaptador nao declara no lugar certo e nao grava"),
+    ("movimento", "velocity", "carPhysics.motion.velocity", "m/s, eixos do mundo", "nao e a velocidade local do carro"),
+    ("movimento", "localAngularVel", None, "rad/s (y = guinada)", "lida pelo adaptador, nao gravada"),
+    ("movimento", "accG", "carPhysics.motion.accG", "g", ""),
+    ("movimento", "heading", "heading", "rad", ""),
+    ("suspensao", "suspensionTravel", "carPhysics.suspension.suspensionTravel", "m", ""),
+    ("suspensao", "rideHeight", "carPhysics.suspension.rideHeight", "m (dianteira, traseira)", ""),
+    ("comandos", "steerAngle", "carPhysics.controls.steerAngle", "sem unidade documentada (ver o relatorio do volante)", ""),
+    ("comandos", "throttle", "carPhysics.controls.throttle", "0 a 1", ""),
+    ("comandos", "brake", "carPhysics.controls.brake", "0 a 1", ""),
+    ("comandos", "clutch", "carPhysics.controls.clutch", "0 a 1",
+     "o adaptador le alem do fim da estrutura do AC1: o valor gravado e sempre 0"),
+    ("comandos", "gear", "carPhysics.controls.gear", "marcha (jogo: 0 = re, 1 = neutro)", ""),
+)
+
+
+def _get(sample: Dict, path: str):
+    value = sample
+    for key in path.split("."):
+        if not isinstance(value, dict):
+            return None
+        value = value.get(key)
+    return value
+
+
+def _flatten(value) -> List[Optional[float]]:
+    if isinstance(value, dict):
+        return [_number(v) for v in value.values()]
+    if isinstance(value, (list, tuple)):
+        return [_number(v) for v in value]
+    return [_number(value)]
+
+
+def _number(value) -> Optional[float]:
+    if value is None or isinstance(value, bool):
+        return float(value) if isinstance(value, bool) else None
+    try:
+        number = float(value)
+    except (TypeError, ValueError):
+        return None
+    return number if np.isfinite(number) else None
+
+
+def scan_recording(path: Path, step: int = 1) -> Dict[str, Dict[str, object]]:
+    """Le um player.jsonl e junta, por campo gravado, os valores e quantas amostras tinham o campo."""
+    values: Dict[str, List[List[Optional[float]]]] = {f: [] for _, f, p, _, _ in FIELDS if p}
+    present: Dict[str, int] = {f: 0 for f in values}
+    total = 0
+    with path.open("r", encoding="utf-8", errors="replace") as handle:
+        for index, line in enumerate(handle):
+            if index % step:
+                continue
+            try:
+                sample = json.loads(line).get("sample") or {}
+            except json.JSONDecodeError:
+                continue
+            total += 1
+            for _, name, field_path, _, _ in FIELDS:
+                if not field_path:
+                    continue
+                raw = _get(sample, field_path)
+                if raw is None:
+                    continue
+                present[name] += 1
+                values[name].append(_flatten(raw))
+    return {"amostras": total, "presentes": present, "valores": values}
+
+
+def summarize(scans: List[Dict[str, object]]) -> Dict[str, object]:
+    total = sum(s["amostras"] for s in scans)
+    out: Dict[str, object] = {"amostras": total, "campos": {}}
+    for group, name, field_path, unit, note in FIELDS:
+        entry: Dict[str, object] = {"grupo": group, "unidade_provavel": unit, "nota": note or None,
+                                    "gravado": bool(field_path), "caminho": field_path}
+        if field_path:
+            rows = [row for s in scans for row in s["valores"][name]]
+            present = sum(s["presentes"][name] for s in scans)
+            width = max((len(r) for r in rows), default=0)
+            matrix = np.array([r + [None] * (width - len(r)) for r in rows], dtype=float) if rows else np.empty((0, 0))
+            filled = np.isfinite(matrix).all(axis=1) if matrix.size else np.array([], dtype=bool)
+            entry["existe"] = present > 0
+            entry["componentes"] = width
+            entry["fracao_preenchida"] = round(float(filled.sum()) / total, 4) if total else 0.0
+            finite = matrix[np.isfinite(matrix)] if matrix.size else np.array([])
+            if finite.size:
+                entry["faixa"] = {"p1": round(float(np.percentile(finite, 1)), 4),
+                                  "p50": round(float(np.percentile(finite, 50)), 4),
+                                  "p99": round(float(np.percentile(finite, 99)), 4)}
+                entry["constante"] = bool(np.nanmin(finite) == np.nanmax(finite))
+                if width > 1:
+                    entry["p50_por_componente"] = [round(float(np.nanmedian(matrix[:, k])), 4) for k in range(width)]
+        else:
+            entry["existe"] = False
+        out["campos"][name] = entry
+    return out
+
+
+def session_recordings(sessions: List[str]) -> Dict[str, List[str]]:
+    inventory = pd.read_parquet(default_inventory_path())
+    october = sorted(i for i in inventory["session_id"].unique() if str(i) >= "2026-10-01")
+    mapping = group_sessions(recording_periods(inventory, october))
+    return {key: sorted(r for r, k in mapping.items() if k == key) for key in sessions}
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--sessoes", nargs="*", default=["2026-10-04", "2026-10-05"])
+    parser.add_argument("--saida", type=Path, default=config.artifacts_root() / "canais" / "inventario_canais.json")
+    args = parser.parse_args(argv)
+    available = {s.session_id: s for s in list_all_sessions()}
+    out: Dict[str, object] = {"sessoes": {}}
+    for key, recordings in session_recordings(args.sessoes).items():
+        by_app: Dict[str, List[str]] = {}
+        for rid in recordings:
+            by_app.setdefault(recording_folder(available[rid].directory), []).append(rid)
+        out["sessoes"][key] = {}
+        for app, rids in sorted(by_app.items()):
+            scans = [scan_recording(available[rid].player_stream) for rid in rids]
+            summary = summarize(scans)
+            summary["gravacoes"] = rids
+            out["sessoes"][key][app] = summary
+            print(f"{key} / {app}: {len(rids)} gravacoes, {summary['amostras']} amostras")
+            for name, entry in summary["campos"].items():
+                if entry["existe"]:
+                    print(f"   {name:20s} {entry['fracao_preenchida']:.3f}  {entry.get('faixa')}  {entry['unidade_provavel']}"
+                          f"{'  CONSTANTE' if entry.get('constante') else ''}")
+                else:
+                    print(f"   {name:20s} nao gravado: {entry['nota']}")
+    args.saida.parent.mkdir(parents=True, exist_ok=True)
+    args.saida.write_text(json.dumps(out, indent=1, ensure_ascii=False), encoding="utf-8")
+    print(f"-> {args.saida}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/backend/ml/scripts/relatorio_volante.py b/backend/ml/scripts/relatorio_volante.py
new file mode 100644
index 00000000..54a2bc7f
--- /dev/null
+++ b/backend/ml/scripts/relatorio_volante.py
@@ -0,0 +1,126 @@
+"""A unidade do volante gravado (pedido 18, Parte B3; ADR 0017, M0).
+
+    python -m ml.scripts.relatorio_volante [--saida ARQUIVO]
+
+O `steerAngle` gravado nao tem unidade documentada. Relata, do store v2:
+
+* a faixa observada nas voltas do piloto e nas da IA, por sessao e app;
+* uma estimativa empirica: abaixo de 80 km/h, nas curvas mais fechadas (raio
+  minimo abaixo de 30 m), a razao entre o volante e a curvatura da trajetoria,
+  `|volante| / |kappa|`, com `kappa = a_lat / v^2` (aceleracao lateral medida e
+  velocidade). So pontos com |a_lat| >= 0,3 g, e com o volante e a curvatura
+  na relacao de sinal que domina (medido: volante positivo com a_lat
+  negativa, ou seja, convencoes de sinal opostas).
+
+Se o volante fosse o angulo das rodas em radianos, a razao ficaria perto do
+entre-eixos do carro (2,5 a 3 m num formula). Se fosse o angulo do volante em
+radianos, perto do entre-eixos vezes a relacao de direcao (dezenas). Se fosse
+uma fracao do curso do volante, mudaria com o ajuste de rotacao do volante.
+Nada e adotado aqui.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+from typing import Dict, List
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+import numpy as np  # noqa: E402
+
+from ml import config  # noqa: E402
+from ml.comparison.evolution import group_sessions  # noqa: E402
+from ml.comparison.lap_vs_reference import _window  # noqa: E402
+from ml.data.store_v2 import load_store_v2, store_v2_meta  # noqa: E402
+from ml.track.corners import detect_corners  # noqa: E402
+from ml.track.geometry import load_geometry  # noqa: E402
+
+G = 9.80665
+MAX_SPEED_KMH = 80.0
+MIN_LATERAL_G = 0.3
+TIGHT_RADIUS_M = 30.0
+
+
+def _stats(values: np.ndarray, digits: int = 4) -> Dict[str, float]:
+    values = np.asarray(values, dtype=float)
+    values = values[np.isfinite(values)]
+    if values.size == 0:
+        return {"n": 0}
+    p1, p25, p50, p75, p99 = np.percentile(values, [1, 25, 50, 75, 99])
+    return {"n": int(values.size), "p1": round(float(p1), digits), "p25": round(float(p25), digits),
+            "p50": round(float(p50), digits), "p75": round(float(p75), digits), "p99": round(float(p99), digits),
+            "max_abs": round(float(np.max(np.abs(values))), digits)}
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--saida", type=Path, default=config.artifacts_root() / "canais" / "relatorio_volante.json")
+    args = parser.parse_args(argv)
+    track = load_geometry()
+    store = load_store_v2(track=track)
+    meta = store_v2_meta()
+    sessions = group_sessions(meta.get("periodos_das_gravacoes") or {})
+    laps = store.laps.assign(sessao=store.laps["session_id"].map(sessions))
+    corners = [c for c in detect_corners(track) if c.min_radius_m < TIGHT_RADIUS_M]
+    inside = np.zeros(track.size, dtype=bool)
+    for corner in corners:
+        inside[_window(track, corner.start_s, corner.end_s)] = True
+    column = "steer_angle" if "steer_angle" in store.frame.columns else "steering"
+
+    groups: Dict[str, List[str]] = {}
+    for _, row in laps.iterrows():
+        if row["sessao"] in ("2026-10-04", "2026-10-05") and row["origem"] in ("humano", "ia"):
+            groups.setdefault(f"{row['sessao']} / {row['origem']} / {row['pasta']}", []).append(row["lap_id"])
+
+    out: Dict[str, object] = {"coluna": column, "curvas_fechadas": [c.label for c in corners],
+                              "limites": {"velocidade_max_kmh": MAX_SPEED_KMH, "a_lat_min_g": MIN_LATERAL_G,
+                                          "raio_minimo_abaixo_de_m": TIGHT_RADIUS_M},
+                              "grupos": {}}
+    for name, lap_ids in sorted(groups.items()):
+        steer_all, ratios, per_lap = [], [], []
+        for lap_id in lap_ids:
+            grid = store.lap(lap_id)
+            steer = grid[column].to_numpy(dtype=float)
+            speed = grid["speed_kmh"].to_numpy(dtype=float) / 3.6
+            lat_g = grid["lateral_g"].to_numpy(dtype=float)
+            steer_all.append(steer)
+            with np.errstate(divide="ignore", invalid="ignore"):
+                kappa = lat_g * G / speed ** 2
+            use = (inside & (speed * 3.6 < MAX_SPEED_KMH) & (np.abs(lat_g) >= MIN_LATERAL_G)
+                   & np.isfinite(steer) & np.isfinite(kappa) & (np.abs(steer) > 1e-4))
+            opposite = np.sign(steer) == -np.sign(kappa)
+            same_side = opposite if (use & opposite).sum() >= (use & ~opposite).sum() else ~opposite
+            r = np.abs(steer[use & same_side]) / np.abs(kappa[use & same_side])
+            ratios.append(r)
+            if r.size:
+                per_lap.append(float(np.median(r)))
+            out.setdefault("_sinais", {}).setdefault(name, []).append(
+                {"volta": lap_id, "pontos": int(use.sum()), "sinais_opostos": int((use & opposite).sum())})
+        steer_values = np.concatenate(steer_all) if steer_all else np.array([])
+        ratio_values = np.concatenate(ratios) if ratios else np.array([])
+        out["grupos"][name] = {
+            "voltas": len(lap_ids),
+            "faixa_do_volante": _stats(steer_values),
+            "razao_volante_curvatura_m": _stats(ratio_values, 3),
+            "mediana_por_volta_m": _stats(np.array(per_lap), 3),
+        }
+    signs = out.pop("_sinais", {})
+    out["pontos_por_grupo"] = {k: {"pontos": sum(v["pontos"] for v in rows),
+                                   "sinais_opostos": sum(v["sinais_opostos"] for v in rows)}
+                               for k, rows in signs.items()}
+    args.saida.parent.mkdir(parents=True, exist_ok=True)
+    args.saida.write_text(json.dumps(out, indent=1, ensure_ascii=False), encoding="utf-8")
+    for name, group in out["grupos"].items():
+        f, r = group["faixa_do_volante"], group["razao_volante_curvatura_m"]
+        print(f"{name}: {group['voltas']} voltas | volante p1 {f.get('p1')} p50 {f.get('p50')} p99 {f.get('p99')} "
+              f"max {f.get('max_abs')} | razao p25 {r.get('p25')} p50 {r.get('p50')} p75 {r.get('p75')} (n {r.get('n')})")
+    print(f"pontos: {out['pontos_por_grupo']}")
+    print(f"-> {args.saida}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
